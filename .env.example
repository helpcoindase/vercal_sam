# ==============================================================================
# Samwarthika Ayurveda Hospital - Environment Variables Template
# Copy this file to .env.local for local development, or add these in Vercel Settings > Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lead Form & Contact Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzsAY0z2M-aZ5SHBOWKAq3ItYUuLlmib-Icpq4GYJEhiNgNcN9MMhzJDxL3wIYNYXYp/exec
NEXT_PUBLIC_MAIL_TO=leads.samwarthika@gmail.com
NEXT_PUBLIC_MAIL_CC=techsupport@kay.org.in

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL / Cloud RDS / TiDB / Aiven)
# Note: On Vercel, DB_HOST cannot be 'localhost'. Use a cloud-hosted MySQL endpoint.
# ------------------------------------------------------------------------------
DB_HOST=your-cloud-db-host.com
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=samwarthika
DB_PORT=3306
# Set DB_SSL=true if your cloud MySQL provider requires SSL (e.g. AWS RDS, TiDB, Aiven)
DB_SSL=false

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_random_32_character_secret_string_here
JWT_EXPIRES_IN=7d